# System Environment Configuration

# Backend Server
PORT=8000
HOST=0.0.0.0
ENV=development

# Firebase Config (Backend - Admin SDK)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=smart-attendance-ai

# Firebase Config (Frontend - Client SDK)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=smart-attendance-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-attendance-ai
VITE_FIREBASE_STORAGE_BUCKET=smart-attendance-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# AI Face Recognition Parameters
FACE_MATCH_THRESHOLD=0.75
LIVENESS_EAR_THRESHOLD=0.20
LIVENESS_CONSECUTIVE_FRAMES=2
MIN_FACE_SIZE=60

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
